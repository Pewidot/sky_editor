diff --git a/src/input/ipc_input.h b/src/input/ipc_input.h
new file mode 100644
index 0000000..b301acc
--- /dev/null
+++ b/src/input/ipc_input.h
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Local, opt-in stdin IPC extension. Events never leave this SDL process.
+#pragma once
+
+#include <array>
+#include <charconv>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <SDL3/SDL.h>
+
+namespace InputIPC {
+enum class Kind : unsigned { Key, Button, Axis };
+struct Pulse {
+    int id{};
+    Kind kind{};
+    Uint32 code{};
+    Sint8 value{};
+    Uint32 duration{};
+};
+inline bool Decimal(std::string_view text, unsigned& result) {
+    const auto parsed = std::from_chars(text.data(), text.data() + text.size(), result);
+    return !text.empty() && parsed.ec == std::errc{} && parsed.ptr == text.data() + text.size();
+}
+inline std::optional<Pulse> Parse(std::string_view request, std::string_view kind,
+                                  std::string_view name, std::string_view duration,
+                                  std::string& error) {
+    unsigned id{}, milliseconds{};
+    if (!Decimal(request, id) || id == 0 || id > 0x7fffffffU || !Decimal(duration, milliseconds) ||
+        milliseconds < 10 || milliseconds > 2000) {
+        error = "id must be 1..2147483647; duration must be 10..2000 decimal ms";
+        return {};
+    }
+    Pulse pulse{static_cast<int>(id), Kind::Key, 0, 0, milliseconds};
+    if (name.empty() || name.size() > 32 || kind.size() > 8) {
+        error = "input name/kind is too long or empty";
+        return {};
+    }
+    if (kind == "key") {
+        const std::string key(name == "enter" ? "Return" : name);
+        pulse.code = SDL_GetKeyFromName(key.c_str());
+        if (pulse.code != SDLK_UNKNOWN)
+            return pulse;
+    } else if (kind == "button") {
+        pulse.kind = Kind::Button;
+        constexpr std::array buttons{std::pair{"cross", SDL_GAMEPAD_BUTTON_SOUTH},
+                                     std::pair{"circle", SDL_GAMEPAD_BUTTON_EAST},
+                                     std::pair{"square", SDL_GAMEPAD_BUTTON_WEST},
+                                     std::pair{"triangle", SDL_GAMEPAD_BUTTON_NORTH},
+                                     std::pair{"options", SDL_GAMEPAD_BUTTON_START},
+                                     std::pair{"share", SDL_GAMEPAD_BUTTON_BACK},
+                                     std::pair{"l1", SDL_GAMEPAD_BUTTON_LEFT_SHOULDER},
+                                     std::pair{"r1", SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER},
+                                     std::pair{"l3", SDL_GAMEPAD_BUTTON_LEFT_STICK},
+                                     std::pair{"r3", SDL_GAMEPAD_BUTTON_RIGHT_STICK},
+                                     std::pair{"pad_up", SDL_GAMEPAD_BUTTON_DPAD_UP},
+                                     std::pair{"pad_down", SDL_GAMEPAD_BUTTON_DPAD_DOWN},
+                                     std::pair{"pad_left", SDL_GAMEPAD_BUTTON_DPAD_LEFT},
+                                     std::pair{"pad_right", SDL_GAMEPAD_BUTTON_DPAD_RIGHT}};
+        for (const auto& [label, code] : buttons)
+            if (name == label) {
+                pulse.code = code;
+                return pulse;
+            }
+    } else if (kind == "axis") {
+        pulse.kind = Kind::Axis;
+        struct NamedAxis {
+            std::string_view name;
+            SDL_GamepadAxis code;
+            Sint8 value;
+        };
+        constexpr std::array axes{NamedAxis{"left_x_minus", SDL_GAMEPAD_AXIS_LEFTX, -127},
+                                  NamedAxis{"left_x_plus", SDL_GAMEPAD_AXIS_LEFTX, 127},
+                                  NamedAxis{"left_y_minus", SDL_GAMEPAD_AXIS_LEFTY, -127},
+                                  NamedAxis{"left_y_plus", SDL_GAMEPAD_AXIS_LEFTY, 127},
+                                  NamedAxis{"right_x_minus", SDL_GAMEPAD_AXIS_RIGHTX, -127},
+                                  NamedAxis{"right_x_plus", SDL_GAMEPAD_AXIS_RIGHTX, 127},
+                                  NamedAxis{"right_y_minus", SDL_GAMEPAD_AXIS_RIGHTY, -127},
+                                  NamedAxis{"right_y_plus", SDL_GAMEPAD_AXIS_RIGHTY, 127},
+                                  NamedAxis{"l2", SDL_GAMEPAD_AXIS_LEFT_TRIGGER, 127},
+                                  NamedAxis{"r2", SDL_GAMEPAD_AXIS_RIGHT_TRIGGER, 127}};
+        for (const auto& axis : axes)
+            if (name == axis.name) {
+                pulse.code = axis.code;
+                pulse.value = axis.value;
+                return pulse;
+            }
+    }
+    error = "unknown named input";
+    return {};
+}
+inline Uint32 EventType() {
+    // The pinned frontend reserves USER+1..USER+15 with literal constants,
+    // without registering them. Leave that range clear before our two events.
+    static const Uint32 type = [] {
+        const auto base = SDL_RegisterEvents(18);
+        return base ? base + 16 : 0;
+    }();
+    return type;
+}
+inline bool Queue(const Pulse& pulse) {
+    if (!(SDL_WasInit(SDL_INIT_EVENTS) & SDL_INIT_EVENTS) || EventType() == 0)
+        return false;
+    SDL_Event event{};
+    event.type = EventType();
+    event.user.code = pulse.id;
+    // Opaque integer payloads, never dereferenced. Supported emulator targets
+    // are 64-bit; no allocation or cross-thread ownership is required.
+    static_assert(sizeof(uintptr_t) >= 8);
+    const uintptr_t packed = uintptr_t(pulse.code) | (uintptr_t(pulse.kind) << 32) |
+                             (uintptr_t(static_cast<Uint8>(pulse.value)) << 40);
+    event.user.data1 = reinterpret_cast<void*>(packed);
+    event.user.data2 = reinterpret_cast<void*>(uintptr_t(pulse.duration));
+    return SDL_PushEvent(&event);
+}
+class Manager {
+    struct Active {
+        Pulse pulse;
+        SDL_TimerID timer;
+    };
+    std::map<int, Active> active;
+    int last_id{};
+    static Uint32 SDLCALL ReleaseTimer(void* userdata, SDL_TimerID, Uint32) {
+        SDL_Event event{};
+        event.type = EventType() + 1;
+        event.user.code = static_cast<int>(reinterpret_cast<uintptr_t>(userdata));
+        // If the SDL queue is temporarily full, retry instead of losing a key-up.
+        return SDL_PushEvent(&event) ? 0 : 10;
+    }
+
+public:
+    using Apply = std::function<void(const Pulse&, bool)>;
+    using Acknowledge = std::function<void(int, std::string_view)>;
+    ~Manager() {
+        for (const auto& [id, item] : active)
+            SDL_RemoveTimer(item.timer);
+    }
+    bool Process(const SDL_Event& event, const Apply& apply, const Acknowledge& ack) {
+        if (event.type != EventType() && event.type != EventType() + 1)
+            return false;
+        const int id = event.user.code;
+        if (event.type == EventType() + 1) {
+            const auto found = active.find(id);
+            if (found != active.end()) {
+                SDL_RemoveTimer(found->second.timer);
+                apply(found->second.pulse, false);
+                active.erase(found);
+                ack(id, "released");
+            }
+            return true;
+        }
+        const auto packed = reinterpret_cast<uintptr_t>(event.user.data1);
+        Pulse pulse{id, static_cast<Kind>((packed >> 32) & 255), static_cast<Uint32>(packed),
+                    static_cast<Sint8>((packed >> 40) & 255),
+                    static_cast<Uint32>(reinterpret_cast<uintptr_t>(event.user.data2))};
+        if (id <= last_id || active.size() >= 16) {
+            ack(id, "error_duplicate_id_or_busy");
+            return true;
+        }
+        for (const auto& [other_id, item] : active) {
+            if (item.pulse.kind == pulse.kind && item.pulse.code == pulse.code) {
+                ack(id, "error_input_already_held");
+                return true;
+            }
+        }
+        last_id = id;
+        apply(pulse, true);
+        const auto timer =
+            SDL_AddTimer(pulse.duration, ReleaseTimer, reinterpret_cast<void*>(uintptr_t(id)));
+        if (!timer) {
+            apply(pulse, false);
+            ack(id, "error_timer_released");
+            return true;
+        }
+        active.emplace(id, Active{pulse, timer});
+        ack(id, "pressed");
+        return true;
+    }
+    void ReleaseAll(const Apply& apply, const Acknowledge& ack) {
+        for (const auto& [id, item] : active) {
+            SDL_RemoveTimer(item.timer);
+            apply(item.pulse, false);
+            ack(id, "cancelled_released");
+        }
+        active.clear();
+    }
+};
+} // namespace InputIPC
